# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/sparrow

# Auth
SECRET_KEY=change-me-to-a-random-64-char-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Anthropic
ANTHROPIC_API_KEY=

# OpenAI (fallback — used automatically if Anthropic returns an auth or 5xx error)
OPENAI_API_KEY=
OPENAI_FALLBACK_MODEL=gpt-4o-mini

# Exa.ai — people search. This is the core discovery dependency; without it
# campaigns find nobody.
# Get your key at https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@sparrow.email

# Stripe — one-time credit pack purchases (no subscriptions).
# Create three one-time prices in Stripe and paste their IDs here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=

# Credit pricing (optional — these are the defaults)
SIGNUP_CREDIT_GRANT=25
CREDITS_PER_CONTACT=1
CREDITS_PER_DRAFT=2
CREDITS_PER_MCP_CALL=1
LOW_BALANCE_THRESHOLD=50

# Google OAuth (end-user sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Analytics
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# File Storage
UPLOAD_DIR=./uploads

# App. BACKEND_URL is also the OAuth issuer and the MCP resource origin, so it
# must be the publicly reachable URL in production.
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development
